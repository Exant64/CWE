{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ImGuiDebug launch (gdb)",
            "type": "gdbtarget",
            "request": "launch",
            "program": "${env:SA2_PATH}/sonic2app.exe",
            "cwd": "${env:SA2_PATH}",
            "target": {
                "type": "remote",

                "host": "localhost",
                "port": "12345",

                "server": "/usr/bin/wine",
                "cwd": "${env:SA2_PATH}",
                "serverParameters": [
                    "/usr/share/win32/gdbserver.exe",
                    "localhost:12345",
                    "${env:SA2_PATH}/sonic2app.exe",
                    "-l",
                    "chaoworld"
                ],

                "serverStartupDelay": 500,
                "automaticallyKillServer": true
            },

            "run": "all",
            "verbose": true,
            "initCommands": [
                "set architecture i386"
            ],
            "preLaunchTask": "${defaultBuildTask}"
        },
        {
            "name": "ImGuiDebug launch (lldb)",
            "type": "lldb",
            "request": "launch",

            "program": "${env:SA2_PATH}/sonic2app.exe",
            "args": ["-l", "chaoworld"],
            "cwd": "${env:SA2_PATH}",
            "sourceMap": {
                "Z:\\": "/"
            },
            "initCommands": [
                "script import subprocess, time",
                "script subprocess.Popen(['/usr/bin/wine', '~/work/LLVM/bin/lldb-server.exe', 'platform', '--listen', 'localhost:12345'], cwd='${env:SA2_PATH}')",
                "script time.sleep(2)",
                "platform select remote-windows",
                "platform connect connect://localhost:12345"
            ],

            "preLaunchTask": "${defaultBuildTask}"
        },
        {
            "name": "Release launch",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${env:SA2_PATH}\\sonic2app.exe",
            "symbolSearchPath": "${workspaceFolder}\\build",
            "cwd": "${env:SA2_PATH}",
            "args": ["-l","chaoworld"],
            "logging": {
                "moduleLoad": false,
                "trace": true
            },
            "preLaunchTask": "ImGuiBuild"
        }
    ]
}