{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ImGuiDebug launch",
            "type": "gdbtarget",
            "request": "launch",
            "program": "${env:SA2_PATH}/sonic2app.exe",
            "cwd": "${env:SA2_PATH}",
            "target": {
                "type": "remote",

                "host": "localhost",
                "port": "12345",

                "server": "/usr/bin/wine",
                "cwd": "${env:SA2_PATH}",
                "serverParameters": [
                    "/usr/share/win32/gdbserver.exe",
                    "localhost:12345",
                    "${env:SA2_PATH}/sonic2app.exe",
                    "-l",
                    "chaoworld"
                ],

                "serverStartupDelay": 500,
                "automaticallyKillServer": true
            },

            "run": "all",
            "verbose": true,
            "initCommands": [
                "set architecture i386"
            ],
            "preLaunchTask": "CMake Build (debug)"
        },
        {
            "name": "Release launch",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${env:SA2_PATH}\\sonic2app.exe",
            "symbolSearchPath": "${workspaceFolder}\\build",
            "cwd": "${env:SA2_PATH}",
            "args": ["-l","chaoworld"],
            "logging": {
                "moduleLoad": false,
                "trace": true
            },
            "preLaunchTask": "ImGuiBuild"
        }
    ]
}